{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kotlin",
  "scopeName": "source.kotlin",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#annotations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.kotlin",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "keyword.other.documentation.kotlin",
              "match": "@(param|return|constructor|receiver|property|throws|exception|sample|see|author|since|suppress)\\b"
            }
          ]
        },
        {
          "name": "comment.block.kotlin",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        },
        {
          "name": "comment.line.double-slash.kotlin",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.kotlin",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-interpolations" }
          ]
        },
        {
          "name": "string.quoted.double.kotlin",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#string-interpolations" }
          ]
        }
      ]
    },
    "string-escapes": {
      "name": "constant.character.escape.kotlin",
      "match": "\\\\(?:[tbnrf'\"\\\\]|u[0-9a-fA-F]{4}|\\$[a-zA-Z_0-9]+)"
    },
    "string-interpolations": {
      "patterns": [
        {
          "name": "meta.template.expression.kotlin",
          "begin": "\\${1,}\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.kotlin" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.kotlin" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "name": "variable.other.readwrite.kotlin",
          "match": "\\${1,}[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.kotlin",
      "match": "'(?:[^\\\\']|\\\\(?:[tbnrf'\"\\\\]|u[0-9a-fA-F]{4}))'"
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.file.kotlin",
          "match": "@file:([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "0": { "name": "entity.name.type.annotation.kotlin" }
          }
        },
        {
          "name": "entity.name.type.annotation.kotlin",
          "match": "@(?:(?:[a-zA-Z_][a-zA-Z0-9_]*):)?([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kotlin",
          "match": "\\b(if|else|when|while|do|for|return|break|continue|throw|try|catch|finally)\\b"
        },
        {
          "name": "keyword.other.kotlin",
          "match": "\\b(package|import|as|is|!is|in|!in|by|where|typealias|constructor|init|companion|field|it)\\b"
        },
        {
          "name": "storage.type.kotlin",
          "match": "\\b(class|interface|object|enum|fun|val|var)\\b"
        },
        {
          "name": "storage.modifier.kotlin",
          "match": "\\b(abstract|final|open|override|sealed|data|inline|noinline|crossinline|reified|external|suspend|tailrec|operator|infix|const|lateinit|vararg|annotation|inner|value|expect|actual|public|private|protected|internal|context)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.kotlin",
          "match": "\\b(Byte|Short|Int|Long|Float|Double|Boolean|Char|String|Unit|Any|Nothing)\\b"
        },
        {
          "name": "entity.name.type.class.kotlin",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.kotlin",
          "match": "(?<=fun\\s+)(?:<[^>]+>\\s+)?(?:[a-zA-Z0-9_<>.]+\\.)?([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.kotlin",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.kotlin",
          "match": "\\b(true|false|null|this|super)\\b"
        },
        {
          "name": "constant.numeric.hex.kotlin",
          "match": "\\b0[xX][0-9a-fA-F_]+[uU]?[lL]?\\b"
        },
        {
          "name": "constant.numeric.binary.kotlin",
          "match": "\\b0[bB][01_]+[uU]?[lL]?\\b"
        },
        {
          "name": "constant.numeric.float.kotlin",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?[fF]?\\b|\\b[0-9][0-9_]*[fF]\\b"
        },
        {
          "name": "constant.numeric.integer.kotlin",
          "match": "\\b[0-9][0-9_]*[uU]?[lL]?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.kotlin",
          "match": "(\\?\\:|\\?\\.|\\!\\!|\\-\\>|\\:\\:|\\.\\.<|\\.\\.|\\=\\=\\=|\\!\\=\\=|\\=\\=|\\!\\=|\\<\\=|\\>\\=|\\&\\&|\\|\\||\\+\\=|\\-\\=|\\*\\=|\\/\\=|\\%\\=|\\=|\\+|\\-|\\*|\\/|\\%|\\<|\\>|\\!)"
        }
      ]
    }
  }
}
